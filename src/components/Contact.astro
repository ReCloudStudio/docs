---
import { Aside } from "@astrojs/starlight/components";
interface Props {
  email: string;
  subject: string;
}
const { email, subject } = Astro.props;
---

<Aside title="联系我们" type="note">
关于{subject}，可通过 <a href={`mailto:${email}`}>{email}</a> 反馈，或在 GitHub 上创建 Issue，亦可通过任何方式联系任意 Director。
</Aside>
